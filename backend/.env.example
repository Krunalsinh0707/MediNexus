# Security & JWT Configuration
SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# HMS_SEED_DEFAULTS defaults to disabled. If enabled, supply a nonblank
# operator-selected DEFAULT_ADMIN_PASSWORD before startup.

# Database Configuration (PostgreSQL)
# Set this in the local process environment. Local development may use the
# existing medinexus database; deployment must supply its own independent URL.
# HMS_DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:5432/medinexus

# Gmail SMTP Configuration for Password Reset OTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-hospital-notifications@example.com
SMTP_PASSWORD=your-google-app-password-16-chars

# CORS Allowed Origins (Comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# AI Clinical Intelligence & Gemini LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# Environment & Debug Mode
ENVIRONMENT=development
DEBUG=False

# Private upload and recovery paths. Keep database URLs in the process
# environment rather than source-controlled files during backup/restore.
HMS_UPLOAD_ROOT=D:/secure/medinexus/uploads
HMS_BACKUP_ROOT=D:/secure/medinexus/backups
HMS_BACKUP_RETENTION_COUNT=7
# Optional when pg_dump/pg_restore are not on PATH.
HMS_PG_BIN_DIR=C:/Program Files/PostgreSQL/18/bin

# Existing department code used as the server-derived prescription destination.
HMS_PHARMACY_DEPARTMENT_CODE=PHARM
HMS_LAB_DEPARTMENT_CODE=LAB
HMS_RADIOLOGY_DEPARTMENT_CODE=RAD
